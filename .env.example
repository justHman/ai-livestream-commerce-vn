# LiveAvatar API credentials — template. Copy to .env and fill in real values.
# .env is gitignored. NEVER commit the real key. Backend-only secret.
LIVEAVATAR_API_KEY=your-liveavatar-api-key-here
LIVEAVATAR_API_BASE=https://api.liveavatar.com
LIVEAVATAR_SANDBOX_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a

# ── Runtime (dev defaults keep offline tests green) ──────────────────
APP_ENV=dev
PORT=8800
# Canonical set: cloud_liveavatar | mock | self_host_avatarforcing_half | self_host_echoavatar_full
RENDER_BACKEND=cloud_liveavatar
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379/0
DEBUG_ENABLED=0

# ── Remote service endpoints (provider-first; empty keeps local/offline) ──
# OpenAI-compatible LLM endpoint consumed by the backend OpenAICompatibleClient
# (backend/application/clients/llm/openai_compatible.py); optional bearer key.
LLM_BASE_URL=
# LLM_AUTH_TOKEN=
# Remote TTS HTTP endpoint consumed by SelfHostedTTSClient
# (backend/application/clients/tts/self_hosted.py).
TTS_BASE_URL=
# Avatar render service base URL (cloud/self-host avatar transport seam).
AVATAR_BASE_URL=
# LiveKit signaling URL (ws://... or wss://...) + API credentials for token mint
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Cross-replica KV cache toggle (lmcache-server desired_count)
LMCACHE_ENABLED=false
# Runtime Postgres (optional; empty keeps memory/redis session store only)
DATABASE_URL=
# Pipecat bridge (default off → StreamOrchestrator)
PIPECAT_ENABLED=false
# Backend PCM publish to LiveKit (requires LIVEKIT_URL + keys)
LIVEKIT_PUBLISH=false
# Outlines guided JSON on openai_compatible responses
LLM_GUIDED_JSON=false
# Director semantic coverage threshold (speech vs key_selling_points)
COVERAGE_MATCH_THRESHOLD=0.75

# ── Engine selection (offline defaults; self-host engines are DEFERRED) ──
#   LLM_ENGINE = none(default echo) | vllm | sglang | hf | llamacpp
#   TTS_ENGINE = transformers(default) | vieneu | cosyvoice | tone
LLM_ENGINE=none
# Provider/BYOK LLM goes through LLM_BASE_URL (+ optional LLM_AUTH_TOKEN above),
# not through a local engine. Self-host vllm model example:
# LLM_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit

TTS_ENGINE=transformers
# TTS_ENGINE=vieneu
# TTS_API_KEY=

# ── Production data-store security (C.3 / R7) ─────────────────────────────
#   prod: REDIS_URL must use rediss:// (TLS). Local dev: redis:// is fine.
#   prod remote DATABASE_URL requires sslmode=require|verify-ca|verify-full;
#   a local/embedded Postgres on loopback is exempt (explicit dev/test store).
#   RATE_LIMIT_TRUST_PROXY_CLIENT_IP=1 trusts ONE configured reverse proxy for
#   the client-IP quota fallback only (never arbitrary forwarded headers);
#   default 0 — authenticated identity is preferred for logical quotas.
# RATE_LIMIT_TRUST_PROXY_CLIENT_IP=0

# ── Provider/self-host vocabulary (B) ─────────────────────────────────────
#   AVATAR_ADAPTER = cloud | self_hosted. Selecting self_hosted while only the
#   stub exists fails startup unless ALLOW_STUB_AVATAR_TEST_ONLY=1 (test-only;
#   the stub never reports a production-ready self-host signal).
AVATAR_ADAPTER=cloud
# ALLOW_STUB_AVATAR_TEST_ONLY=
#   TTS engine model source is engine-specific: tts_model_source=sdk (default;
#   SDK/provider download on first use — no mandatory S3/offline bootstrap).
#   s3 is a DORMANT future path requiring WEIGHTS_S3_URI.
# TTS_MODEL_SOURCE=sdk
#   Internal service credential (client+server parity) for the backend->TTS
#   HTTP seam; hosted TTS providers use TTS_API_KEY / ELEVENLABS_API_KEY.
# TTS_AUTH_TOKEN=

# ── Voice persistence (C.1 / R6.2) ────────────────────────────────────────
#   Voice metadata + binary/reference assets resolve through a provider-neutral
#   object store. file:// is explicit dev/test only; production multi-replica
#   requires a durable URI (e.g. s3://bucket/prefix).
TTS_VOICE_STORE_URI=file://./.runtime/voice-store
