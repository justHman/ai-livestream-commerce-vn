# Stage 2 — LiveAvatar cloud + real LLM/TTS (no LiveKit).
# Avatar video flows LiveAvatar cloud → browser directly; no SFU needed.
# LLM/TTS self-hosted on 1 Spot g6.xlarge (L4 24GB): vLLM (Qwen3.5-4B-AWQ) +
# vllm-omni (fork feat/vieneu-tts-v0.22, VieNeu-TTS), GPU partitioned
# LLM gpu_memory_utilization=0.55 / TTS=0.35 / 0.10 buffer.
#
# MONEY-SAFE BOOT: copy this to terraform.tfvars, then Phase 0 apply with
# desired_llm = 0 / desired_tts = 0 (edit the values below), verify stack
# healthy at zero cost, complete offline setup (GitHub Actions SHA images,
# S3 weights seed, SSM secrets), then Phase 1 apply with desired_llm = 0 /
# desired_tts = 0. See docs/runbook-live-smoke-and-teardown.md.
#
# LiveAvatar sandbox-first: LIVEAVATAR_SANDBOX_AVATAR_ID
# (dd73ea75-1218-4ef3-92ce-606d5f7fbc0a, free ~1-min, no credits) for first
# smoke; switch to a real credit-charged avatar only for the formal bench.
#
# Stage 1 PASS report + teardown verification REQUIRED before any Stage 2 plan.

env                 = "dev"
project             = "ai-livestream"
aws_region          = "ap-northeast-2"

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidr   = "10.20.1.0/24"
public_subnet_cidr_b = "10.20.2.0/24"
# g6.xlarge available in 2a/2c/2d; pin engine AZ to 2a, ALB/RDS span 2a/2b.
az                   = "ap-northeast-2a"
az_b                 = "ap-northeast-2b"
alb_ingress_cidrs    = ["0.0.0.0/0"]
certificate_arn      = ""

db_instance_class       = "db.t4g.medium"
db_allocated_storage_gb = 100
redis_node_type         = "cache.t4g.small"

# Money-safe boot Phase 1 values. Phase 0: set desired_llm = 0 / desired_tts = 0.
desired_backend     = 1
desired_llm     = 0
desired_tts     = 0
desired_avatar      = 0
# Engine box (g6) capacity providers must exist for desired_llm + desired_tts > 0.
create_ec2_capacity = true
spot_capacity_percentage = 100

# Images: SHA-tagged from GitHub Actions (replace <sha> with the build SHA).
# No :latest, no hand-push on billable stages. ARM ↔ arm64, GPU ↔ amd64.
image_backend = "imjusthman/ai-live-backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
image_llm = "imjusthman/ai-live-llm@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
image_tts = "imjusthman/ai-live-tts@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
image_avatar = "imjusthman/ai-live-avatar@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Tokens: set via TF_VAR_backend_api_token / TF_VAR_admin_api_token (min 32 chars).
# db_password: set via TF_VAR_db_password (8-128 chars)
# LIVEAVATAR_API_KEY: put in SSM SecureString /ai-livestream/dev/liveavatar/api_key
# out-of-band (aws ssm put-parameter --overwrite --type SecureString). The
# compute module injects it into the backend task via secrets_arns. Never
# commit the key; reports redact it.
cors_origins      = "*"
debug_enabled     = true
session_store     = "redis"
redis_url         = ""
app_env           = "dev"
avatar_adapter  = "liveavatar"
llm_adapter     = "openai_compatible"
tts_adapter     = "self_hosted"

alert_email           = ""
enable_billing_alarms = false
