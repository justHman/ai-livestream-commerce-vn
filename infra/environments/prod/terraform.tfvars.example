# Prod sample — copy to terraform.tfvars.local (secrets) / terraform.tfvars (non-secrets).
# NEVER commit real passwords or cert private material.

env        = "prod"
project    = "ai-livestream"
aws_region = "ap-northeast-2"

vpc_cidr             = "10.30.0.0/16"
public_subnet_cidr   = "10.30.1.0/24"
public_subnet_cidr_b = "10.30.2.0/24"
az                   = "ap-northeast-2a"
az_b                 = "ap-northeast-2b"
# Network module creates 2 public AZs (ALB/RDS). No NAT.

# Restrict to Cloudflare published IPs when grey-cloud/proxy is on.
alb_ingress_cidrs = ["0.0.0.0/0"]
# Required secrets/config are passed via environment, never assigned in this example:
# TF_VAR_certificate_arn=arn:aws:acm:ap-northeast-2:ACCOUNT:certificate/UUID
# TF_VAR_db_password=...
# TF_VAR_backend_api_token=...
# TF_VAR_admin_api_token=...

# Required only when enable_database_url is true: ARN of an existing SSM SecureString.
enable_database_url        = false
database_url_parameter_arn = ""

db_instance_class       = "db.t4g.medium"
db_allocated_storage_gb = 100
redis_node_type         = "cache.t4g.small"

desired_backend     = 1
desired_llm     = 0
desired_tts     = 0
desired_avatar      = 0
create_ec2_capacity = false
# Set create_ec2_capacity=true and opt in desired_* only after GPU/avatar/LiveKit E2E validation.

image_backend = "imjusthman/ai-live-backend:latest"
image_llm     = "imjusthman/ai-live-llm:latest"
image_tts     = "imjusthman/ai-live-tts:latest"
image_avatar  = "imjusthman/ai-live-avatar:latest"

cors_origins      = "https://example.com"
debug_enabled     = false
session_store     = "redis"
redis_url         = ""
app_env           = "prod"
render_backend    = "mock"
llm_engine        = "none"
llm_base_url      = ""
tts_engine        = "tone"
tts_base_url      = ""
spot_capacity_percentage = 100

# Replace with the approved avatar/LMCache image tags for a real GPU release.

alert_email           = ""
enable_billing_alarms = false # enable from global/us-east-1
