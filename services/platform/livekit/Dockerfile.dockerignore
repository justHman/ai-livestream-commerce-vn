# Root-context build exclusions for platform/livekit/Dockerfile.
# Build: docker build -f services/platform/livekit/Dockerfile .
# Allows: services/platform/livekit/ (livekit.yaml, entrypoint.sh).

# VCS / CI / tooling
.git
.github
.claude
.superpowers
.codegraph
.venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache

# Secrets
.env
*.env
!.env.example

# All product services (livekit image never imports service code)
services/product

# Workbench, infra, docs, tests, benchmarks
workbench/
infra/
docs/
plans/
notes/
benchmarks/
tests/
scripts/

# Runtime / model weights / data
.runtime/
models/
model/
data/
sources/
results/
weights/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.log
*.wav
*.mp4
tmp/
archive/
archived/
