{
  "components": {
    "schemas": {
      "CapabilityResponse": {
        "description": "Provider-neutral capability facts.\n\nShape mirrors `ProviderCapabilities`; provider payloads (speaker\nembeddings, reference codes, tensors) never serialize here.",
        "properties": {
          "max_batch_size": {
            "default": 1,
            "title": "Max Batch Size",
            "type": "integer"
          },
          "model_revision": {
            "title": "Model Revision",
            "type": "string"
          },
          "provider_name": {
            "title": "Provider Name",
            "type": "string"
          },
          "sample_rate_hz": {
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "supported_expressive_cues": {
            "items": {
              "type": "string"
            },
            "title": "Supported Expressive Cues",
            "type": "array"
          },
          "supported_response_formats": {
            "items": {
              "type": "string"
            },
            "title": "Supported Response Formats",
            "type": "array"
          },
          "supported_styles": {
            "items": {
              "type": "string"
            },
            "title": "Supported Styles",
            "type": "array"
          },
          "supports_mixed_voice_batch": {
            "default": false,
            "title": "Supports Mixed Voice Batch",
            "type": "boolean"
          },
          "supports_native_batch": {
            "default": false,
            "title": "Supports Native Batch",
            "type": "boolean"
          },
          "supports_voice_cloning": {
            "default": false,
            "title": "Supports Voice Cloning",
            "type": "boolean"
          }
        },
        "required": [
          "provider_name",
          "model_revision",
          "sample_rate_hz"
        ],
        "title": "CapabilityResponse",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SpeechRequest": {
        "additionalProperties": false,
        "description": "Synthesis request \u2014 text, voice, and output bounds.\n\n`model_config` forbids unknown fields so provider-specific payloads\n(speaker embeddings, reference codes, tensors) fail loudly at the API\nboundary instead of being silently dropped or leaking into the runtime.",
        "properties": {
          "chunk_seq": {
            "default": 0,
            "minimum": 0.0,
            "title": "Chunk Seq",
            "type": "integer"
          },
          "language": {
            "default": "vi",
            "title": "Language",
            "type": "string"
          },
          "priority": {
            "default": "normal",
            "enum": [
              "normal",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          },
          "response_format": {
            "default": "pcm",
            "enum": [
              "pcm",
              "wav"
            ],
            "title": "Response Format",
            "type": "string"
          },
          "sample_rate": {
            "default": 24000,
            "maximum": 48000.0,
            "minimum": 8000.0,
            "title": "Sample Rate",
            "type": "integer"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "speed": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speed",
            "type": "number"
          },
          "style": {
            "default": "natural",
            "title": "Style",
            "type": "string"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "utterance_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Utterance Id"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "voice_profile_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Profile Id"
          }
        },
        "required": [
          "text"
        ],
        "title": "SpeechRequest",
        "type": "object"
      },
      "SpeechResponse": {
        "description": "Metadata for a synthesized utterance.",
        "properties": {
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "format": {
            "default": "pcm",
            "title": "Format",
            "type": "string"
          },
          "sample_rate": {
            "title": "Sample Rate",
            "type": "integer"
          },
          "voice": {
            "default": "",
            "title": "Voice",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "sample_rate",
          "duration_ms"
        ],
        "title": "SpeechResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceInfo": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "engine": {
            "default": "",
            "title": "Engine",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "language": {
            "default": "vi",
            "title": "Language",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "VoiceInfo",
        "type": "object"
      },
      "VoiceListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/VoiceInfo"
            },
            "title": "Data",
            "type": "array"
          },
          "object": {
            "default": "list",
            "title": "Object",
            "type": "string"
          }
        },
        "title": "VoiceListResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Self-host TTS synthesis service",
    "title": "ai-live-tts",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audio/capabilities": {
      "get": {
        "description": "Return provider-neutral capability facts.\n\nCluster 1 serves a static capability stub (provider defaults from config);\nthe runtime cluster replaces it with the active provider's capabilities.\nNo speaker embeddings or reference codes ever appear here.",
        "operationId": "audio_capabilities_v1_audio_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Audio Capabilities"
      }
    },
    "/v1/audio/speech": {
      "post": {
        "description": "Synthesize speech from text.\n\nReturns raw PCM (int16 mono) by default, or a WAV container when\n`response_format=wav`. Auth, body limit, and GPU concurrency gates run\nbefore any engine work.",
        "operationId": "synthesize_v1_audio_speech_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Synthesize"
      }
    },
    "/v1/speech": {
      "post": {
        "description": "Synthesize speech from text.\n\nReturns raw PCM (int16 mono) by default, or a WAV container when\n`response_format=wav`. Auth, body limit, and GPU concurrency gates run\nbefore any engine work.",
        "operationId": "synthesize_v1_speech_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Synthesize"
      }
    },
    "/v1/speech/formats": {
      "get": {
        "description": "Return supported output formats.",
        "operationId": "list_formats_v1_speech_formats_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Formats"
      }
    },
    "/v1/voices": {
      "get": {
        "description": "Return the voices available on the active self-host engine.",
        "operationId": "list_voices_v1_voices_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Voices"
      }
    }
  }
}
