{
  "$id": "backend/contracts/v1/websocket/platform.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "clientMessage": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 128,
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "ts": {
          "type": "number"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "events": {
      "error": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "type": {
            "const": "error"
          }
        },
        "required": [
          "type",
          "detail"
        ],
        "type": "object"
      },
      "platform.accepted": {
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "type": "string"
          },
          "type": {
            "const": "platform.accepted"
          }
        },
        "required": [
          "type",
          "comment_id"
        ],
        "type": "object"
      },
      "platform.connected": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string"
          },
          "type": {
            "const": "platform.connected"
          }
        },
        "required": [
          "type",
          "session_id"
        ],
        "type": "object"
      },
      "platform.stored": {
        "additionalProperties": false,
        "properties": {
          "pending": {
            "type": "integer"
          },
          "type": {
            "const": "platform.stored"
          }
        },
        "required": [
          "type",
          "pending"
        ],
        "type": "object"
      }
    },
    "serverEvent": {
      "oneOf": [
        {
          "$ref": "#/definitions/events/error"
        },
        {
          "$ref": "#/definitions/events/platform.accepted"
        },
        {
          "$ref": "#/definitions/events/platform.connected"
        },
        {
          "$ref": "#/definitions/events/platform.stored"
        }
      ],
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  "description": "Viewer chat ingress on /api/v1/ws/platform/{session_id}. The client posts {text, author?, ts?}; the backend replies with an acceptance/storage event or an error. Consumed by the workbench platform client.",
  "properties": {
    "clientMessage": {
      "$ref": "#/definitions/clientMessage"
    },
    "serverEvent": {
      "$ref": "#/definitions/serverEvent"
    }
  },
  "title": "Backend platform WebSocket channel",
  "type": "object"
}
