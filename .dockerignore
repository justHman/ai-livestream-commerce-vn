# Conservative fallback for root-context builds. Per-service policy lives in
# each built Dockerfile's adjacent <Dockerfile>.dockerignore (1.56).
# Weights NEVER enter the image (aws-architecture §2.5).

.git
.github
.claude
.superpowers
.codegraph
.venv
.runtime
.pytest_cache
.ruff_cache
__pycache__
*.py[cod]
*.egg-info
.env
*.env
!.env.example

# Heavy / local-only
weights/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
model/
models/
data/
sources/
results/
papers/
notebooks/
archived/
archive/
docs/
plans/
infra/
frontend/
workbench/
notes/
configs/
